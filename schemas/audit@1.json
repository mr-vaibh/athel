{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.athel.invalid/audit@1.json",
  "title": "athel/audit@1",
  "description": "One line of .athel/audit/YYYY-MM-DD.jsonl, the hash-chained audit log (doc 04 §Audit log). hash = sha256 of the record's canonical JSON without hash; prev_hash links to the previous record (genesis: 64 zeros).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "seq", "ts", "kind", "session", "prompt_id", "change", "step", "task", "agent", "tool",
    "tool_use_id", "action", "input_sha256", "tier", "env", "decision", "rule", "code", "policy_hash", "from", "to",
    "by", "reason", "idempotency_key", "duration_us", "result", "prev_hash", "hash"],
  "properties": {
    "schema": {"const": "athel/audit@1"},
    "seq": {"type": "integer", "minimum": 1},
    "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "kind": {"enum": ["tool_decision", "tool_completed", "tool_failed", "hook", "transition", "illegal_transition",
      "human_required", "step_enter", "step_exit", "lock_takeover", "grant_created", "grant_used", "integrity_accept"]},
    "session": {"type": ["string", "null"], "maxLength": 200},
    "prompt_id": {"type": ["string", "null"], "maxLength": 200},
    "change": {"type": ["string", "null"], "pattern": "^CHG-[0-9]{3,}(-F[1-9][0-9]*)?$"},
    "step": {"type": ["string", "null"], "maxLength": 64},
    "task": {"type": ["string", "null"], "maxLength": 64},
    "agent": {"type": ["string", "null"], "maxLength": 200},
    "tool": {"type": ["string", "null"], "maxLength": 200},
    "tool_use_id": {"type": ["string", "null"], "maxLength": 200},
    "action": {"type": ["string", "null"], "maxLength": 2100, "description": "scrubbed action text"},
    "input_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "tier": {"enum": ["R0", "R1", "W0", "W1", "W2", "W3", "X", null]},
    "env": {"type": ["string", "null"], "maxLength": 64},
    "decision": {"enum": ["allow", "deny", "approve", "none", null]},
    "rule": {"type": ["string", "null"], "maxLength": 64},
    "code": {"type": ["string", "null"], "pattern": "^E-[A-Z]+-[A-Z-]+$"},
    "policy_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "from": {"type": ["string", "null"], "maxLength": 64},
    "to": {"type": ["string", "null"], "maxLength": 64},
    "by": {"type": ["string", "null"], "maxLength": 16},
    "reason": {"type": ["string", "null"], "maxLength": 2000},
    "idempotency_key": {"type": ["string", "null"], "maxLength": 300, "description": "reserved: <change>:<step>:<task>:<op> (doc 02)"},
    "duration_us": {"type": ["integer", "null"], "minimum": 0},
    "result": {"enum": ["ok", "error"]},
    "prev_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
