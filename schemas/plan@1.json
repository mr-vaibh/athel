{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.athel.invalid/plan@1.json",
  "title": "athel/plan@1",
  "description": "plan.yaml: the change plan, a task graph (doc 05 §The change plan). Every write Athel makes must match one task (doc 04 rule 7). hash is computed by the CLI over everything except hash; approval binds to it.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "change", "hash", "tasks"],
  "properties": {
    "schema": {"const": "athel/plan@1"},
    "change": {"type": "string", "pattern": "^CHG-[0-9]{3,}(-F[1-9][0-9]*)?$"},
    "hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "repo", "paths", "verbs", "covers", "depends_on", "size", "gates"],
        "properties": {
          "id": {"type": "string", "pattern": "^T-[0-9]{2,}$"},
          "title": {"type": "string", "minLength": 1, "maxLength": 200},
          "repo": {"type": "string", "pattern": "^[A-Za-z0-9._-]{1,100}$"},
          "paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "resources": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "verbs": {"type": "array", "minItems": 1, "items": {"enum": ["edit", "create", "delete", "test", "commit", "push", "pr", "comment"]}},
          "covers": {"type": "array", "items": {"type": "string", "pattern": "^AC-[0-9]+$"}},
          "depends_on": {"type": "array", "items": {"type": "string", "pattern": "^T-[0-9]{2,}$"}},
          "size": {"enum": ["S", "M", "L"]},
          "gates": {"type": "array", "items": {"type": "string"}},
          "risk_notes": {"type": "string"},
          "rollback": {"type": "string"},
          "env_actions": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
