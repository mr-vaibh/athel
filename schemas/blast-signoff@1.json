{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.athel.invalid/blast-signoff@1.json",
  "title": "athel/blast-signoff@1",
  "description": "blast-signoff.yaml: the developer's explicit sign-off of a CRITICAL blast radius report (doc 05 §Risk rules: CRITICAL needs sign-off on the report itself in addition to plan approval). Bound to the report's hash: a changed report voids it. Written only by `athel blast signoff` with the developer's /athel:signoff grant.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "change",
    "report_sha256",
    "risk",
    "by",
    "at",
    "grant"
  ],
  "properties": {
    "schema": {
      "const": "athel/blast-signoff@1"
    },
    "change": {
      "type": "string",
      "pattern": "^CHG-[0-9]{3,}(-F[1-9][0-9]*)?$"
    },
    "report_sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "risk": {
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "CRITICAL"
      ]
    },
    "by": {
      "const": "human"
    },
    "at": {
      "$ref": "#/$defs/timestamp"
    },
    "grant": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    }
  },
  "$defs": {
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    }
  }
}
