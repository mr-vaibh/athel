{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.athel.invalid/qa-report@1.json",
  "title": "athel/qa-report@1",
  "description": "QA's report for a task (doc 06 role table, FR-BUILD-004): reviews/T-NN/qa-N.yaml. The negative, boundary and failure tests QA added, the suite result, the gaps, and findings for the developer; each finding joins the task's review round.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "change",
    "task",
    "n",
    "head",
    "cases",
    "suite",
    "gaps",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "athel/qa-report@1"
    },
    "change": {
      "type": "string",
      "pattern": "^CHG-[0-9]{3,}(-F[1-9][0-9]*)?$"
    },
    "task": {
      "type": "string",
      "pattern": "^T-[0-9]{2,}$"
    },
    "n": {
      "type": "integer",
      "minimum": 1
    },
    "head": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "file",
          "name",
          "result"
        ],
        "properties": {
          "category": {
            "enum": [
              "negative",
              "boundary",
              "failure"
            ]
          },
          "file": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "covers": {
            "type": "string",
            "pattern": "^AC-[0-9]+$"
          },
          "result": {
            "enum": [
              "pass",
              "fail"
            ]
          }
        }
      }
    },
    "suite": {
      "$ref": "#/$defs/command"
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "result"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "location",
        "rule",
        "finding",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[QS][1-9][0-9]*-[0-9]{2,}$"
        },
        "severity": {
          "enum": [
            "blocker",
            "major",
            "minor",
            "nit"
          ]
        },
        "cwe": {
          "type": "string",
          "pattern": "^CWE-[1-9][0-9]*$"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
