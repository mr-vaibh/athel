{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.athel.invalid/hook-event@1.json",
  "title": "athel/hook-event@1",
  "description": "One line of .athel/audit/hook-events.jsonl. Field names follow the doc 04 audit record so M1's hash-chained audit can adopt them; raw tool input is never stored (no scrubber before M1), only its hash.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "seq", "ts", "event", "session", "prompt_id", "agent", "change", "step",
    "task", "tool", "tool_use_id", "input_sha256", "tier", "env", "decision", "rule",
    "policy_hash", "result", "prev_hash", "duration_us"],
  "properties": {
    "schema": {"const": "athel/hook-event@1"},
    "seq": {"type": "integer", "minimum": 1},
    "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "event": {"enum": ["SessionStart", "UserPromptSubmit", "PreToolUse", "PostToolUse",
      "PostToolUseFailure", "SubagentStop", "Stop", "PreCompact", "SessionEnd"]},
    "session": {"type": ["string", "null"], "maxLength": 200},
    "prompt_id": {"type": ["string", "null"], "maxLength": 200},
    "agent": {"type": ["string", "null"], "maxLength": 200},
    "change": {"type": ["string", "null"], "pattern": "^CHG-[0-9]{3,}(-F[1-9][0-9]*)?$"},
    "step": {"type": ["string", "null"], "maxLength": 64},
    "task": {"type": ["string", "null"], "maxLength": 64},
    "tool": {"type": ["string", "null"], "maxLength": 200},
    "tool_use_id": {"type": ["string", "null"], "maxLength": 200},
    "input_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "tier": {"type": "null", "description": "reserved: permission tier (M1)"},
    "env": {"type": "null", "description": "reserved: resolved environment (M1)"},
    "decision": {"enum": ["allow", "deny", "approve", null]},
    "rule": {"type": ["string", "null"], "maxLength": 64},
    "policy_hash": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "result": {"enum": ["ok", "error"]},
    "prev_hash": {"type": "null", "description": "reserved: hash chain (M1)"},
    "duration_us": {"type": "integer", "minimum": 0}
  }
}
