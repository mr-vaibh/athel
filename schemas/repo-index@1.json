{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.athel.invalid/repo-index@1.json",
  "title": "athel/repo-index@1",
  "description": ".athel/repos/index.yaml: the developer's local clones under the confirmed search roots, mapped to their normalised remotes (doc 03 §Finding local clones; FR-DISC-015). Built only by `athel repos index`; the clones themselves are only ever read (FR-DISC-016).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "indexed_at", "roots", "repos"],
  "properties": {
    "schema": {"const": "athel/repo-index@1"},
    "indexed_at": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "roots": {"type": "array", "uniqueItems": true, "maxItems": 50, "items": {"type": "string", "pattern": "^/", "maxLength": 1024}},
    "repos": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["remote", "path", "default_branch", "last_commit_at", "fact"],
        "properties": {
          "remote": {
            "description": "Normalised remote: host/org/repo, SSH and HTTPS forms alike (doc 03 step 3). null for a clone without an origin remote.",
            "oneOf": [{"type": "string", "pattern": "^[a-z0-9.-]+(:[0-9]+)?/[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)+$", "maxLength": 300}, {"type": "null"}]
          },
          "path": {"type": "string", "pattern": "^/", "maxLength": 1024},
          "default_branch": {"oneOf": [{"type": "string", "minLength": 1, "maxLength": 255}, {"type": "null"}]},
          "last_commit_at": {"oneOf": [{"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"}, {"type": "null"}]},
          "fact": {"description": "The structural fact recording this mapping, with its recipe.", "oneOf": [{"type": "string", "pattern": "^F-[0-9]{4,}$"}, {"type": "null"}]}
        }
      }
    }
  }
}
