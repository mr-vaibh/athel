{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.athel.invalid/config@1.json",
  "title": "athel/config@1",
  "description": "athel.yaml at any config layer (built-in, org, user, project). Every key is optional except schema; merge rules live in cli/internal/config.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema"],
  "properties": {
    "schema": {"const": "athel/config@1"},
    "overridable": {
      "description": "Dotted keys that layers below this one may set freely, even looser (decision Q7).",
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z_]+(\\.[a-z_]+)*$"}
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "default": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_cost_usd": {"type": "number", "minimum": 0},
            "max_hours": {"type": "number", "minimum": 0},
            "max_tool_calls": {"type": "integer", "minimum": 0}
          }
        },
        "warn_ratio": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "locks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ttl_min": {"type": "integer", "minimum": 1, "maximum": 1440},
        "heartbeat_min": {"type": "integer", "minimum": 1, "maximum": 1440}
      }
    },
    "identity": {"type": "string", "minLength": 1, "maxLength": 200},
    "features": {"type": "object", "additionalProperties": {"type": "boolean"}}
  }
}
