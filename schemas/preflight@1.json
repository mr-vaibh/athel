{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.athel.invalid/preflight@1.json",
  "title": "athel/preflight@1",
  "description": "Git preflight report for one repo of a change (.athel/changes/CHG-NNN/preflight/<repo>.md, doc 04 \u00a7Preflight algorithm, FR-GIT-002/003): others' active work, its overlap with the planned paths, and the card raised when someone else's open work overlaps.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "change",
    "repo",
    "remote",
    "base",
    "base_head",
    "branch",
    "at",
    "planned_paths",
    "open_prs",
    "branches",
    "recent_commits",
    "overlaps",
    "clean",
    "card"
  ],
  "properties": {
    "schema": {
      "const": "athel/preflight@1"
    },
    "change": {
      "type": "string",
      "pattern": "^CHG-[0-9]{3,}(-F[1-9][0-9]*)?$"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,100}$"
    },
    "remote": {
      "type": "string",
      "minLength": 1
    },
    "base": {
      "type": "string",
      "minLength": 1
    },
    "base_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "at": {
      "type": "string",
      "minLength": 1
    },
    "planned_paths": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "open_prs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "number",
          "author",
          "head",
          "files"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1
          },
          "author": {
            "type": "string"
          },
          "head": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "branches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "author",
          "pushed_at",
          "files"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string"
          },
          "pushed_at": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "recent_commits": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "sha",
          "author",
          "at",
          "files"
        ],
        "properties": {
          "sha": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string"
          },
          "at": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "overlaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "ref",
          "author",
          "files",
          "blocking"
        ],
        "properties": {
          "kind": {
            "enum": [
              "pr",
              "branch",
              "commit"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1
          },
          "author": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "blocking": {
            "type": "boolean"
          }
        }
      }
    },
    "clean": {
      "type": "boolean",
      "description": "true when no blocking overlap exists"
    },
    "card": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^D-[1-9][0-9]*$"
    }
  }
}
