{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.athel.invalid/security-report@1.json",
  "title": "athel/security-report@1",
  "description": "The security agent's report for a task (doc 06 role table, FR-BUILD-005): reviews/T-NN/security-N.yaml. What it checked in the diff and its dependency changes, and findings with their CWE category; each finding joins the task's review round.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "change",
    "task",
    "n",
    "head",
    "checked",
    "findings"
  ],
  "properties": {
    "schema": {
      "const": "athel/security-report@1"
    },
    "change": {
      "type": "string",
      "pattern": "^CHG-[0-9]{3,}(-F[1-9][0-9]*)?$"
    },
    "task": {
      "type": "string",
      "pattern": "^T-[0-9]{2,}$"
    },
    "n": {
      "type": "integer",
      "minimum": 1
    },
    "head": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "checked": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/finding"
          },
          {
            "required": [
              "cwe"
            ]
          }
        ]
      }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "result"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "location",
        "rule",
        "finding",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[QS][1-9][0-9]*-[0-9]{2,}$"
        },
        "severity": {
          "enum": [
            "blocker",
            "major",
            "minor",
            "nit"
          ]
        },
        "cwe": {
          "type": "string",
          "pattern": "^CWE-[1-9][0-9]*$"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
