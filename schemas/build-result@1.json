{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.athel.invalid/build-result@1.json",
  "title": "athel/build-result@1",
  "description": "The developer's result for one round of a task (doc 06 role table): build/T-NN/result-N.yaml. The CLI fills in the changed files, the tests among them and the commit; the developer gives the commands it ran and its notes. The reviewer never sees it (FR-BUILD-006).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "change",
    "task",
    "n",
    "head",
    "files_changed",
    "tests_added",
    "commands_run",
    "notes"
  ],
  "properties": {
    "schema": {
      "const": "athel/build-result@1"
    },
    "change": {
      "type": "string",
      "pattern": "^CHG-[0-9]{3,}(-F[1-9][0-9]*)?$"
    },
    "task": {
      "type": "string",
      "pattern": "^T-[0-9]{2,}$"
    },
    "n": {
      "type": "integer",
      "minimum": 1
    },
    "head": {
      "type": "string",
      "pattern": "^([0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "files_changed": {
      "$ref": "#/$defs/paths"
    },
    "tests_added": {
      "$ref": "#/$defs/paths"
    },
    "commands_run": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "notes": {
      "type": "string"
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "result"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "pass",
            "fail"
          ]
        }
      }
    },
    "paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "location",
        "rule",
        "finding",
        "required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[QS][1-9][0-9]*-[0-9]{2,}$"
        },
        "severity": {
          "enum": [
            "blocker",
            "major",
            "minor",
            "nit"
          ]
        },
        "cwe": {
          "type": "string",
          "pattern": "^CWE-[1-9][0-9]*$"
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "finding": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
