{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.athel.invalid/change@5.json",
  "title": "athel/change@5",
  "description": "State of one Athel change (.athel/changes/CHG-NNN/change.yaml). Version 2 (M1) binds plan approval to the plan hash and adds the integrity record. Version 3 (M2) fills flags: a fact this change relied on was disputed or superseded (doc 03 FR-DISC-005). Version 4 (M4) fills repos (Athel's worktree, branch and pull request per repo) and waivers. Version 5 (M5) fills change_set: the change's repos as one set, with roles, merge order and the deferred removal, derived by the CLI from the approved plan (doc 04 §Multi-repo change sets, ADR 035). Reserved fields must stay empty until the milestone that fills them bumps the version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "title",
    "state",
    "blocked_from",
    "created_by",
    "created_at",
    "updated_at",
    "prd",
    "step",
    "step_attempts",
    "stop_blocks",
    "checkpoints",
    "budget",
    "lock",
    "approvals",
    "waivers",
    "repos",
    "build",
    "change_set",
    "parent",
    "flags",
    "history",
    "integrity"
  ],
  "properties": {
    "schema": {
      "const": "athel/change@5"
    },
    "id": {
      "$ref": "#/$defs/changeId"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "state": {
      "$ref": "#/$defs/state"
    },
    "blocked_from": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/workingState"
        }
      ]
    },
    "created_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "created_at": {
      "$ref": "#/$defs/timestamp"
    },
    "updated_at": {
      "$ref": "#/$defs/timestamp"
    },
    "prd": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "versions"
      ],
      "properties": {
        "current": {
          "$ref": "#/$defs/prdVersion"
        },
        "versions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "version",
              "path",
              "sha256",
              "source",
              "at"
            ],
            "properties": {
              "version": {
                "$ref": "#/$defs/prdVersion"
              },
              "path": {
                "type": "string",
                "pattern": "^prd/v[1-9][0-9]*\\.md$"
              },
              "sha256": {
                "$ref": "#/$defs/hash"
              },
              "source": {
                "enum": [
                  "file",
                  "text",
                  "stdin"
                ]
              },
              "at": {
                "$ref": "#/$defs/timestamp"
              }
            }
          }
        }
      }
    },
    "step": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "task",
            "started_at",
            "ended_at",
            "attempt",
            "status",
            "reason"
          ],
          "properties": {
            "name": {
              "$ref": "#/$defs/step"
            },
            "task": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/taskId"
                }
              ]
            },
            "started_at": {
              "$ref": "#/$defs/timestamp"
            },
            "ended_at": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/timestamp"
                }
              ]
            },
            "attempt": {
              "type": "integer",
              "minimum": 1
            },
            "status": {
              "enum": [
                "running",
                "ok",
                "blocked",
                "failed"
              ]
            },
            "reason": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "#/$defs/text"
                }
              ]
            }
          }
        }
      ]
    },
    "step_attempts": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/step"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "stop_blocks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "count"
      ],
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "checkpoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "step",
          "at",
          "note",
          "session",
          "trigger"
        ],
        "properties": {
          "name": {
            "$ref": "#/$defs/checkpointName"
          },
          "step": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/$defs/step"
              }
            ]
          },
          "at": {
            "$ref": "#/$defs/timestamp"
          },
          "note": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "string",
                "maxLength": 4000
              }
            ]
          },
          "session": {
            "$ref": "#/$defs/sessionId"
          },
          "trigger": {
            "enum": [
              "manual",
              "precompact"
            ]
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_cost_usd",
        "max_hours",
        "max_tool_calls",
        "used_cost_usd",
        "used_minutes",
        "used_tool_calls",
        "status",
        "events"
      ],
      "properties": {
        "max_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "max_hours": {
          "type": "number",
          "minimum": 0
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "used_cost_usd": {
          "type": "number",
          "minimum": 0
        },
        "used_minutes": {
          "type": "number",
          "minimum": 0
        },
        "used_tool_calls": {
          "type": "integer",
          "minimum": 0
        },
        "status": {
          "$ref": "#/$defs/budgetStatus"
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "at",
              "status",
              "dimension"
            ],
            "properties": {
              "at": {
                "$ref": "#/$defs/timestamp"
              },
              "status": {
                "$ref": "#/$defs/budgetStatus"
              },
              "dimension": {
                "enum": [
                  "cost",
                  "time",
                  "tool_calls"
                ]
              }
            }
          }
        }
      }
    },
    "lock": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "session",
            "since",
            "heartbeat_at",
            "ttl_min"
          ],
          "properties": {
            "session": {
              "$ref": "#/$defs/sessionId"
            },
            "since": {
              "$ref": "#/$defs/timestamp"
            },
            "heartbeat_at": {
              "$ref": "#/$defs/timestamp"
            },
            "ttl_min": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1440
            }
          }
        }
      ]
    },
    "approvals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plan"
      ],
      "properties": {
        "plan": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "hash",
                "by",
                "at",
                "session",
                "prompt_id"
              ],
              "properties": {
                "hash": {
                  "$ref": "#/$defs/hash"
                },
                "by": {
                  "const": "human"
                },
                "at": {
                  "$ref": "#/$defs/timestamp"
                },
                "session": {
                  "oneOf": [
                    {
                      "type": "null"
                    },
                    {
                      "$ref": "#/$defs/sessionId"
                    }
                  ]
                },
                "prompt_id": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "maxLength": 200
                }
              }
            }
          ],
          "description": "plan approval bound to the plan hash (doc 05 FR-PLAN-004); any change to plan.yaml voids it"
        }
      }
    },
    "waivers": {
      "type": "array",
      "description": "Gate and finding waivers, each from the developer's own /athel:waive (doc 06 FR-BUILD-014)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task",
          "subject",
          "by",
          "reason",
          "until",
          "grant",
          "at"
        ],
        "properties": {
          "task": {
            "type": "string",
            "pattern": "^T-[0-9]{2,}$"
          },
          "subject": {
            "type": "string",
            "pattern": "^([a-z][a-z0-9-]{1,40}|R[1-9][0-9]*-[0-9]{2,})$"
          },
          "by": {
            "const": "human"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "until": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
          },
          "grant": {
            "type": "string",
            "minLength": 1
          },
          "at": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "repos": {
      "type": "array",
      "description": "Athel's worktrees and branches for this change, one per repo (doc 02, M4)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "remote",
          "base",
          "base_head",
          "branch",
          "worktree",
          "pushed",
          "pr"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9._-]{1,100}$",
            "description": "the plan's repo name"
          },
          "remote": {
            "type": "string",
            "pattern": "^[A-Za-z0-9.-]+(/[A-Za-z0-9._-]+)+$",
            "description": "host/org/repo"
          },
          "base": {
            "type": "string",
            "minLength": 1
          },
          "base_head": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
          },
          "branch": {
            "type": "string",
            "minLength": 1
          },
          "worktree": {
            "type": "string",
            "pattern": "^repos/[A-Za-z0-9._-]{1,100}@CHG-[0-9]{3,}(-F[1-9][0-9]*)?$",
            "description": "relative to the workspace root"
          },
          "pushed": {
            "type": "boolean"
          },
          "pr": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "change_set": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "strategy",
        "repos",
        "invariant",
        "verify"
      ],
      "description": "the change's repos as one set (doc 04 §Change set record); null until the plan is approved",
      "properties": {
        "strategy": {
          "enum": [
            "single",
            "expand_contract",
            "coordinated"
          ],
          "description": "single: one repo; coordinated: compatibility is impossible and the set merges together (doc 04 rule 5)"
        },
        "repos": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repo",
              "role",
              "order",
              "pr",
              "state",
              "depends_on",
              "deferred",
              "note"
            ],
            "properties": {
              "repo": {
                "type": "string",
                "minLength": 1,
                "description": "the plan's repo name"
              },
              "role": {
                "enum": [
                  "provider",
                  "consumer",
                  "provider_cleanup",
                  "internal"
                ],
                "description": "from the repo's task kinds: expand or migrate make a provider, consume a consumer, deferred contract tasks the later cleanup"
              },
              "order": {
                "type": "integer",
                "minimum": 1,
                "description": "merge step; repos with the same order may merge in either order"
              },
              "pr": {
                "type": [
                  "string",
                  "null"
                ],
                "pattern": "^[^#\\s]+#[0-9]+$",
                "description": "owner/repo#number once the PR is open"
              },
              "state": {
                "enum": [
                  "draft",
                  "ready",
                  "merged",
                  "closed",
                  null
                ],
                "description": "the PR's state as Athel last saw it"
              },
              "depends_on": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "description": "repos of this set whose PRs must merge first"
              },
              "deferred": {
                "type": "boolean",
                "description": "true for the later cleanup: never built in this change (doc 04 rule 3)"
              },
              "note": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "what the deferred cleanup removes"
              }
            }
          }
        },
        "invariant": {
          "type": "string",
          "minLength": 1
        },
        "verify": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "at",
            "result",
            "heads"
          ],
          "description": "the last merge-order rehearsal (ADR 036); its evidence is changeset/verify.yaml",
          "properties": {
            "at": {
              "type": "string"
            },
            "result": {
              "enum": [
                "pass",
                "fail"
              ]
            },
            "heads": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "description": "base and PR heads the rehearsal ran on, keyed repo@base and repo@head"
            }
          }
        }
      }
    },
    "parent": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^CHG-[0-9]{3,}$",
      "description": "the change a side-finding fix belongs to (doc 07 FR-FIND-004); null for a top-level change"
    },
    "flags": {
      "type": "array",
      "description": "Facts this change used (knowledge/access.jsonl) that verification later disputed or superseded (doc 03 FR-DISC-005). Written only by the CLI.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "fact",
          "replacement",
          "at",
          "reason",
          "resolved_at"
        ],
        "properties": {
          "kind": {
            "enum": [
              "fact_disputed",
              "fact_superseded"
            ]
          },
          "fact": {
            "$ref": "#/$defs/factId"
          },
          "replacement": {
            "oneOf": [
              {
                "$ref": "#/$defs/factId"
              },
              {
                "type": "null"
              }
            ]
          },
          "at": {
            "$ref": "#/$defs/timestamp"
          },
          "reason": {
            "$ref": "#/$defs/text"
          },
          "resolved_at": {
            "oneOf": [
              {
                "$ref": "#/$defs/timestamp"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "seq",
          "from",
          "to",
          "by",
          "at",
          "reason",
          "evidence",
          "origin"
        ],
        "properties": {
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "from": {
            "$ref": "#/$defs/state"
          },
          "to": {
            "$ref": "#/$defs/state"
          },
          "by": {
            "enum": [
              "human",
              "athel"
            ]
          },
          "at": {
            "$ref": "#/$defs/timestamp"
          },
          "reason": {
            "$ref": "#/$defs/text"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "sha256"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 1024
                },
                "sha256": {
                  "$ref": "#/$defs/hash"
                }
              }
            }
          },
          "origin": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "session",
              "prompt_id"
            ],
            "properties": {
              "session": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "$ref": "#/$defs/sessionId"
                  }
                ]
              },
              "prompt_id": {
                "oneOf": [
                  {
                    "type": "null"
                  },
                  {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                ]
              }
            }
          }
        }
      }
    },
    "integrity": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "hash",
            "at"
          ],
          "properties": {
            "hash": {
              "$ref": "#/$defs/hash"
            },
            "at": {
              "$ref": "#/$defs/timestamp"
            }
          }
        }
      ],
      "description": "hash of this file as the CLI last wrote it (doc 02 security baseline, E-INTEGRITY)"
    },
    "build": {
      "type": "array",
      "description": "Each plan task's build status (doc 06 build loop; M4-plan G9: kept here so plan.yaml never changes after approval)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "started_at",
          "done_at",
          "commits"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^T-[0-9]{2,}$"
          },
          "status": {
            "enum": [
              "in_progress",
              "done",
              "blocked"
            ]
          },
          "started_at": {
            "type": "string",
            "minLength": 1
          },
          "done_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "commits": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "blocked_from": {
            "$ref": "#/$defs/workingState"
          }
        }
      },
      "else": {
        "properties": {
          "blocked_from": {
            "type": "null"
          }
        }
      }
    }
  ],
  "$defs": {
    "factId": {
      "type": "string",
      "pattern": "^F-[0-9]{4,}$"
    },
    "changeId": {
      "type": "string",
      "pattern": "^CHG-[0-9]{3,}(-F[1-9][0-9]*)?$"
    },
    "taskId": {
      "type": "string",
      "pattern": "^T-[0-9]{2,}$"
    },
    "prdVersion": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._:-]{1,200}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "checkpointName": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "budgetStatus": {
      "enum": [
        "ok",
        "warning",
        "exceeded"
      ]
    },
    "workingState": {
      "enum": [
        "draft",
        "investigating",
        "specified",
        "awaiting_decisions",
        "planned",
        "plan_approved",
        "building",
        "ready_for_pr",
        "in_review",
        "verifying",
        "uat"
      ]
    },
    "state": {
      "enum": [
        "draft",
        "investigating",
        "specified",
        "awaiting_decisions",
        "planned",
        "plan_approved",
        "building",
        "ready_for_pr",
        "in_review",
        "verifying",
        "uat",
        "done",
        "blocked",
        "cancelled"
      ]
    },
    "step": {
      "enum": [
        "start",
        "investigate",
        "spec",
        "blast-radius",
        "decide",
        "plan",
        "git-preflight",
        "build",
        "review",
        "verify",
        "ship",
        "uat",
        "learn"
      ]
    }
  }
}
