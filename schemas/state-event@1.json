{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.athel.invalid/state-event@1.json",
  "title": "athel/state-event@1",
  "description": "One line of .athel/audit/state-events.jsonl: transitions, rejected transitions, step start and end, lock take-overs.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "seq", "ts", "kind", "change", "session", "step", "from", "to", "by", "reason", "error_code"],
  "properties": {
    "schema": {"const": "athel/state-event@1"},
    "seq": {"type": "integer", "minimum": 1},
    "ts": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"},
    "kind": {"enum": ["transition", "illegal_transition", "human_required", "step_enter", "step_exit", "lock_takeover"]},
    "change": {"type": "string", "pattern": "^CHG-[0-9]{3,}(-F[1-9][0-9]*)?$"},
    "session": {"type": ["string", "null"], "maxLength": 200},
    "step": {"type": ["string", "null"], "maxLength": 64},
    "from": {"type": ["string", "null"], "maxLength": 64},
    "to": {"type": ["string", "null"], "maxLength": 64},
    "by": {"type": ["string", "null"], "maxLength": 16},
    "reason": {"type": ["string", "null"], "maxLength": 2000},
    "error_code": {"type": ["string", "null"], "pattern": "^E-[A-Z]+-[A-Z-]+$"}
  }
}
