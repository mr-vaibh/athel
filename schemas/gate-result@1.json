{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.athel.invalid/gate-result@1.json",
  "title": "athel/gate-result@1",
  "description": "Gate evidence for one task (.athel/changes/CHG-NNN/gates/T-NN.yaml, doc 06 \u00a7Quality gates, FR-BUILD-009): the baseline taken before the task's first edit and every gate run, judged against it by the CLI.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "change",
    "task",
    "repo",
    "baseline",
    "runs"
  ],
  "properties": {
    "schema": {
      "const": "athel/gate-result@1"
    },
    "change": {
      "type": "string",
      "pattern": "^CHG-[0-9]{3,}(-F[1-9][0-9]*)?$"
    },
    "task": {
      "type": "string",
      "pattern": "^T-[0-9]{2,}$"
    },
    "repo": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]{1,100}$"
    },
    "baseline": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "head",
        "at",
        "lint",
        "tests",
        "exits",
        "coverage"
      ],
      "properties": {
        "head": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
        },
        "at": {
          "type": "string"
        },
        "lint": {
          "type": "string"
        },
        "tests": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tests",
            "broken_packages"
          ],
          "properties": {
            "tests": {
              "type": "object",
              "additionalProperties": {
                "enum": [
                  "pass",
                  "fail",
                  "skip"
                ]
              }
            },
            "broken_packages": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "exits": {
          "type": "object",
          "additionalProperties": {
            "type": "integer"
          }
        },
        "coverage": {
          "type": [
            "number",
            "null"
          ],
          "description": "total statement coverage on base, in percent"
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "n",
          "stage",
          "head",
          "at",
          "green",
          "results"
        ],
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1
          },
          "stage": {
            "enum": [
              "cheap",
              "full"
            ]
          },
          "head": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"
          },
          "at": {
            "type": "string"
          },
          "green": {
            "type": "boolean"
          },
          "results": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "gate",
                "status",
                "summary",
                "details",
                "command",
                "exit",
                "duration_ms",
                "output",
                "flaky"
              ],
              "properties": {
                "gate": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "enum": [
                    "pass",
                    "fail",
                    "unavailable",
                    "skipped"
                  ]
                },
                "summary": {
                  "type": "string"
                },
                "details": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "command": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "exit": {
                  "type": "integer"
                },
                "duration_ms": {
                  "type": "integer",
                  "minimum": 0
                },
                "output": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "flaky": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
